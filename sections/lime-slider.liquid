<style>
                  body {
                      position: relative;
                      height: 100%;
                      margin: 0;
                      padding: 0;
                      background: #eee;
                      font-family: Helvetica Neue, Helvetica, Arial, sans-serif;
                      font-size: 14px;
                      color: #000;
                    }

                   .swiper-container {
      width: 100%;
      height: 100%;
      padding-top: 20px;
      position: relative;
  padding-right: 30px;
      padding-left: 30px;

  }
                    .swiper-slide {
                      margin-right:30px;
                      text-align: center;
                      font-size: 18px;
                      background: #fff;
                      display: inline-table;
                    }

                    .swiper-slide img {
                      display: block;
                      width: 100%;
                      height: 100%;
                      object-fit: cover;
                    }

                    .swiper-button-next,
                    .swiper-button-prev {
                      background-color: #fff;
                      border-radius: 50%;
                      padding: 10px;
                    }
                  .swiper-slide.swiper-haris.swiper-slide-next {

                      width: 100% !important
                  }

                .cstm-container {
                    width: 96%;
                    margin: 0 auto;
                }


              .swiper-button-next:after, .swiper-button-prev:after {
                  color: #000;
                  font-size: 20px;
                  font-weight: 700;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  height: 100%;
              }
            .swiper-button-prev:after, .swiper-rtl .swiper-button-next:after {
                content: 'prev';
            }


            .swiper-button-next:after, .swiper-button-prev:after {
                color: #000;
                font-size: 20px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100%;
            }

            .swiper-button-next:after, .swiper-rtl .swiper-button-prev:after {
                content: 'next';
            }
          .swiper-button-next, .swiper-button-prev {
            /* display: block; */
            position: absolute;
            top: 50%;
            width: 24px;
            height: 24px;
            z-index: 10;
            cursor: pointer;
            transform: translateY(-50%);
            fill: #000;
            padding:30px;
          }


          .swiper-button-next {
            right: 10px;

          .swiper-button-prev {
            left: 10px;
          }

            .swiper-slide.swiper-haris {
            margin-right: 30px;
        }



    .swiper-button-prev {
          display: none;
      }


     .swiper-button-next {
          display: none;
      }
                   @media only screen and (max-width: 768px) {
                  .swiper-slide.swiper-haris.swiper-slide-next {

                      width: 100% !important
                  }


    .swiper-button-prev {
          display: none;
      }


     .swiper-button-next {
          display: none;
      }


                   }
</style>

<div class="swiper-container    swiper-parent  swiper-{{ section.id }}">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide  swiper-haris">
        <a class="anchore-swiper" href="#">
          <img src="{{ block.settings.image_with_text_image | img_url: 'large' }}" alt="">
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="swiper-button-next">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
      <path d="M8.29 16.29a1 1 0 0 1 0-1.42L12.88 12 8.29 7.71a1 1 0 1 1 1.42-1.42l5 5a1 1 0 0 1 0 1.42l-5 5a1 1 0 0 1-1.42 0z"/>
    </svg>
  </div>

  <div class="swiper-button-prev">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
      <path d="M15.71 16.29a1 1 0 0 1-1.42 0l-5-5a1 1 0 0 1 0-1.42l5-5a1 1 0 1 1 1.42 1.42L10.12 12l5.59 5.29a1 1 0 0 1 0 1.42z"/>
    </svg>
  </div>
</div>

<script>
    var swiper = new Swiper(".swiper-{{ section.id }}", {
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
    slidesPerView: 1,
  spaceBetween: 30,
      loop: true
    });
</script>

{% schema %}
 {
  "name": "lime slider1",
  "settings": [
    {
      "type": "range",
      "id": "slider_value",
      "label": "Slider Value",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_with_text_image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "lime slider1",
      "category": "Custom"
    }
  ]
}
{% endschema %}
