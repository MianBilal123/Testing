 <script>
    var swiper = new Swiper(".mySwiper", {
      loop: true,
      spaceBetween: 10,
      slidesPerView: 4,
      freeMode: true,
      watchSlidesProgress: true,
    });
    var swiper2 = new Swiper(".mySwiper2", {
      loop: true,
      spaceBetween: 10,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      thumbs: {
        swiper: swiper,
      },
    });
document.addEventListener("DOMContentLoaded", function() {

  // Initialize Swiper for the main image slider
  var mainSwiper = new Swiper('.mySwiper2', {
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    loop: true, // Enable loop if desired
  });

  // Get all secondary images
  const secondaryImages = document.querySelectorAll('.product-secondary-img');

  // Add click event listener to each secondary image
  secondaryImages.forEach(function(image) {
    image.addEventListener('click', function() {
      // Get the index of the clicked image
      const imageIndex = this.getAttribute('data-index');
      
      // Move the Swiper slider to the corresponding slide
      mainSwiper.slideTo(parseInt(imageIndex), 500); // 500ms transition time
    });
  });

});


document.addEventListener("DOMContentLoaded", function() {
  const quantityInput = document.getElementById("Quantity-template");
  const plusButtons = document.querySelectorAll('button[name="plus"]');
  const minusButtons = document.querySelectorAll('button[name="minus"]');

  // Attach event listener to all plus buttons
  plusButtons.forEach(plusButton => {
    plusButton.addEventListener("click", function() {
      let currentQuantity = parseInt(quantityInput.value);
      if (currentQuantity < 10) { // Ensure the maximum is 10
        quantityInput.value = currentQuantity + 1; // Increase quantity
      }
    });
  });

  // Attach event listener to all minus buttons
  minusButtons.forEach(minusButton => {
    minusButton.addEventListener("click", function() {
      let currentQuantity = parseInt(quantityInput.value);
      if (currentQuantity > 1) { // Ensure the minimum is 1
        quantityInput.value = currentQuantity - 1; // Decrease quantity
      }
    });
  });
});



