// 2ndcode
document.querySelectorAll('input[name^="options"]').forEach((input) => {
    input.addEventListener('change', function () {
        updateMasterSelector();
    });
});

function updateMasterSelector() {
    const selectedOptions = [];

    // Gather selected options
    document.querySelectorAll('input[name^="options"]:checked').forEach((selectedInput) => {
        selectedOptions.push(selectedInput.value);
    });

    // Find the matching variant based on selected options
    const selectElement = document.getElementById('SingleOptionSelector-0');
    let selectedVariantId = null;
    let selectedVariantQuantity = null;

    Array.from(selectElement.options).forEach(option => {
        const variant = option.text.split(' / '); // Assuming variant titles are in format like 'Size / Color'
        
        // Check if selected options match the variant options
        if (JSON.stringify(variant) === JSON.stringify(selectedOptions)) {
            selectedVariantId = option.value;
            selectedVariantQuantity = parseInt(option.getAttribute('data-quantity'), 10); // Get variant quantity
        }
    });

    if (selectedVariantId) {
        // Set the selected variant ID in the hidden master selector
        selectElement.value = selectedVariantId;

        // Check if the selected variant is sold out (quantity is 0)
        const addToCartButton = document.getElementById('add-to-cart');
        if (selectedVariantQuantity === 0) {
            // Disable the button and show "Sold Out"
            addToCartButton.disabled = true;
            addToCartButton.textContent = 'Sold Out';
        } else {
            // Enable the button if there's stock available
            addToCartButton.disabled = false;
            addToCartButton.textContent = 'Add to Cart';
        }
    }
}

// Handle Add to Cart
document.getElementById('add-to-cart').addEventListener('click', function () {
    // Get the selected variant ID from the hidden select element
    const selectedVariantId = document.getElementById('SingleOptionSelector-0').value;
    
    // Get the quantity
    const quantity = document.getElementById('quantity').value;

    // Proceed to add to cart
    addToCart(selectedVariantId, quantity);
});

// Function to add the selected variant to the cart
function addToCart(variantId, quantity = 1) {
    fetch('/cart/add.js', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            id: variantId, // Use the selected variant ID
            quantity: quantity
        })
    })
    .then(response => response.json())
    .then(data => {
        console.log('Product added to cart:', data);
        // Optionally redirect to the cart page
        window.location.href = '/cart';
    })
    .catch(error => {
        console.error('Error adding product to cart:', error);
        alert('Failed to add product to cart.');
    });
}








   

   
