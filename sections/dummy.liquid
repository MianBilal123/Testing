    //     document.getElementById("mySidenav").style.width = "0";
    //   }
    // function openNav(){
    //   document.getElementById("mySidenav").style.width ="270px";
    // }
    function openNav() {
      // Show the sidenav and close button
      document.getElementById("mySidenav").classList.add("active");
      document.getElementById("closemmn").style.display = "flex";  // Show the close button
  }

  function closeNav() {
      // Hide the sidenav and close button
      document.getElementById("mySidenav").classList.remove("active");
      document.getElementById("closemmn").style.display = "none";  // Hide the close button
  }
</script>

<div class="main_header  main_navbar desktop-view">
  <header class="site_header">
    <h1 class="header-logo">
      <a href="/" class="site-logo">
        <img src="{{ section.settings.image_with_text_image | img_url: 'medium' }}" alt="">
      </a>
    </h1>

    <div class="textblock">
      <form class="search-header  search" action="" method="get">
        <div class="input-group">
          <input class="input_field" type="search" placeholder="Search for products, brands and more">
          <span class="input-group__btn"
            ><button class="btn search__submit" type="submit" style="margin-left: 10px;">
              <i class="at at-search-l"></i> <span class="icon__fallback-text">Submit</span>
            </button></span
          >
        </div>
      </form>
    </div>
    <div class="icon-field">
      <a href="" class="hdrHelp">Help</a>
      <a href="" class="hdicon site-settings" title="Settings">
        <svg xmlns="http://www.w3.org/2000/svg" width="23" height="20" viewBox="0 0 23 24" fill="none">
