          <path d="M14.7664 15.0527C14.7664 15.0527 19.1084 17.0327 20.4794 19.3197C21.2677 20.4261 21.6454 21.7728 21.5474 23.1277L9.27637 23.2077" stroke="#1A1818" stroke-miterlimit="10"></path>
        </svg>
      </a>
      <a href="" class="hdicon wishlist hide-sm hide-md" title="Wishlist">
        <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="23" height="20" viewBox="0 0 48 48">
          <path d="M 15 7 C 8.9424416 7 4 11.942442 4 18 C 4 22.096154 7.0876448 25.952899 10.851562 29.908203 C 14.615481 33.863507 19.248379 37.869472 22.939453 41.560547 A 1.50015 1.50015 0 0 0 25.060547 41.560547 C 28.751621 37.869472 33.384518 33.863507 37.148438 29.908203 C 40.912356 25.952899 44 22.096154 44 18 C 44 11.942442 39.057558 7 33 7 C 29.523564 7 26.496821 8.8664883 24 12.037109 C 21.503179 8.8664883 18.476436 7 15 7 z M 15 10 C 17.928571 10 20.3663 11.558399 22.732422 15.300781 A 1.50015 1.50015 0 0 0 25.267578 15.300781 C 27.6337 11.558399 30.071429 10 33 10 C 37.436442 10 41 13.563558 41 18 C 41 20.403846 38.587644 24.047101 34.976562 27.841797 C 31.68359 31.30221 27.590312 34.917453 24 38.417969 C 20.409688 34.917453 16.31641 31.30221 13.023438 27.841797 C 9.4123552 24.047101 7 20.403846 7 18 C 7 13.563558 10.563558 10 15 10 z"></path>
        </svg>
      </a>
      <a href="" id="cartLink" class="hdicon header-cart" title="Cart" role="button" aria-haspopup="dialog">
        <svg
          aria-hidden="true"
          focusable="false"
          role="presentation"
          class="icon icon-cart"
          viewBox="0 0 25 25 "
          width="23"
          height="20"
        >
          <path d="M5.058 23a2 2 0 1 0 4.001-.001A2 2 0 0 0 5.058 23zm12.079 0c0 1.104.896 2 2 2s1.942-.896 1.942-2-.838-2-1.942-2-2 .896-2 2zM0 1a1 1 0 0 0 1 1h1.078l.894 3.341L5.058 13c0 .072.034.134.042.204l-1.018 4.58A.997.997 0 0 0 5.058 19h16.71a1 1 0 0 0 0-2H6.306l.458-2.061c.1.017.19.061.294.061h12.31c1.104 0 1.712-.218 2.244-1.5l3.248-6.964C25.423 4.75 24.186 4 23.079 4H5.058c-.157 0-.292.054-.438.088L3.844.772A1 1 0 0 0 2.87 0H1a1 1 0 0 0-1 1zm5.098 5H22.93l-3.192 6.798c-.038.086-.07.147-.094.19-.067.006-.113.012-.277.012H7.058v-.198l-.038-.195L5.098 6z"></path>
        </svg>
      </a>
    </div>
  </header>

  <div class="shopify_section desktop-nav ">
    <ul class="nav_list">
      {% for link in section.settings.menu.links %}
        <li class="list_child">
          <a href="{{ link.url }}">{{ link.title }} |</a>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

