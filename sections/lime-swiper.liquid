<style>
  .text-start{
  font-weight:800;
  color:yellow;
  }
            .swiper {
              width: 100%;
              height: 100%;
            }

            .swiper-slide {
              text-align: center;
              font-size: 18px;
              /* background: #fff; */
              justify-content: center;
              align-items: center;
            }

        img.sec-slider {
      border-radius: 50%;
      display: block;
      height: 100%;
      width: 100%;
      padding: 0px 10px;
      /* background-color: black; */
      object-fit: contain;
  }
          .swiper {
              width: 90%;
              height: 100%;
            justify-content:center;
          }
            .swiper-horizontal {
              touch-action: pan-y;
          }
            .swiper {
              margin-left: auto;
              margin-right: auto;
              position: relative;
              overflow: hidden;
              list-style: none;
              padding: 0;
              z-index: 1;
              display: block;
          }
            .swiper-wrapper {
              position: relative;
              width: 100%;
              height: 100%;
              z-index: 1;


          }
            .swiper.mySwiper.swiper-initialized.swiper-horizontal.swiper-backface-hidden {
              padding-left: 10px;
              padding-right: 10px;
              margin: 0 auto;
          }
          .pic-parent {
          cursor: pointer;
          padding: 5px;
      }

            .swiper-slide.swiper-slide-next {
              width: 25%;
          }

          @media only screen and (max-width: 768px) {

              .pic-parent {
        width: 100px;
    }



      .swiper {
        width: 100%;
      }

      img.sec-slider {
        height: 100px;
        /* padding: 0px 5px; */
      }

      /* .swiper-slide {
        width: auto;  /* Ensure slide width is adjusted */
      } */
    }
</style>
<div class="circular-collection-container-2">
  <div class="circular-collection-wrapper-2">
    <div class="swiper mySwiper">
      <div class="circular-collection-heading-2">
        <a href="">
          <h1 class="text-start">Accessories</h1>
        </a>
      </div>
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide moez">
            <!-- Fixed the class declaration -->
            <div class="pic-parent">
              <img class="sec-slider" src="{{ block.settings.image_with_text_image | img_url: 'master' }}" alt="">
            </div>
            <div class="circular-collection-title">
              <h1 class="text-center">{{ block.settings.img_titel }}</h1>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<div class="circular-collection-wrapper-line last-child"></div>
<script>
      var swiper = new Swiper(".mySwiper", {  // Target ".mySwiper" instead of ".swiper"
    slidesPerView: 7.5,
    spaceBetween: 10,
    loop: true,
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    breakpoints: {
      768: {
        slidesPerView: 4.1,
        spaceBetween: 10
      },
      990: {
        slidesPerView: 7.5,
        spaceBetween: 10
      }
    }
  });
</script>

{% schema %}
    {
  "name": "lime slider2",
  "settings": [
    {
      "type": "range",
      "id": "slider_value",
      "label": "Slider Value",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_with_text_image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "img_titel",
          "label": "img titel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "lime slider2"
    }
  ]
}
{% endschema %}
