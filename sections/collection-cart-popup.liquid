<script>


document.addEventListener('DOMContentLoaded',function(){
  const cartOpen=document.querySelectorAll('.ji');
const popUp = document.querySelector('.cart-pop-up');
const closePop=document.querySelector('.close-btn');
const overlay=document.querySelector('.overlay');

cartOpen.forEach(function(icon) {
  icon.addEventListener('click', function(e) {
    popUp.classList.remove('hidden');
    overlay.classList.remove('hidden');
  });
});

closePop.addEventListener('click',function(e){
    popUp.classList.add('hidden');
    overlay.classList.add('hidden');
});

overlay.addEventListener('click',function(){
  popUp.classList.add('hidden');
    overlay.classList.add('hidden');

});




});
</script>

