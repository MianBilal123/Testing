<style>
    body {
      position: relative;
      height: 100%;
      margin: 0;
      padding: 0;
      background: #eee;
      font-family: Helvetica Neue, Helvetica, Arial, sans-serif;
      font-size: 14px;
      color: #000;
    }

    .swiper-container {
      width: 100%;
      height: 100%;
      padding-left: 20px;
      padding-right: 20px;
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      background: #fff;
      display: inline-table;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .swiper-button-next,
    .swiper-button-prev {
      background-color: #fff;
      border-radius: 50%;
      padding: 10px;
    }
  .swiper-slide.swiper-haris.swiper-slide-next {

      width: 100% !important
  }
   @media only screen and (max-width: 768px) {
  .swiper-slide.swiper-haris.swiper-slide-next {

      width: 100% !important
  }
   }
</style>

<div class="swiper-container  swiper-parent  swiper-{{ section.id }}">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide  swiper-haris">
        <a href="#">
          <img src="{{ block.settings.image_with_text_image | img_url: 'large' }}" alt="">
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
</div>

<script>
  var swiper = new Swiper(".swiper-{{ section.id }}", {
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    slidesPerView: 1,
    spaceBetween: 30,
    loop: true
  });
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [
    {
      "type": "range",
      "id": "slider_value",
      "label": "Slider Value",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_with_text_image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
