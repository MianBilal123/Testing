<script>
     // Get all instances of the nav-menu-item containers
  const menuItems = document.querySelectorAll('#nav-menu-item');

  // Loop through each menu item and add the event listener
  menuItems.forEach(function(item) {
    const toggleParagraph = item.querySelector('p');  // Select the <p> inside each menu-item
    const toggleList = item.querySelector('ul');  // Select the <ul> inside each menu-item

    // Add click event listener to each <p> element
    toggleParagraph.addEventListener('click', function() {
      // Hide all other <ul> elements
      menuItems.forEach(function(otherItem) {
        const otherList = otherItem.querySelector('ul');
        if (otherList !== toggleList) {
          otherList.style.display = 'none';  // Hide all other lists
        }
      });

      // Toggle the display of the clicked <ul> element
      if (toggleList.style.display === 'none') {
        toggleList.style.display = 'block';  // Show the list
      } else {
        toggleList.style.display = 'none';   // Hide the list
      }
    });
  });
</script>

