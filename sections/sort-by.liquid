 // Function to handle Quick View
function quickview(productId) {
    // Get the product URL from the clicked SVG
    const svgElement = document.querySelector(`#quickview-icon`);
    const productUrl = svgElement.getAttribute('data-url');

    // Make sure the product URL is valid
    if (!productUrl) {
        console.error("Product URL is not found.");
        return;
    }

    // Construct API endpoint (adjust the URL structure to match your API)
    const apiUrl = `/api/quickview${productUrl}`;

    // Fetch product data from the API
    fetch(apiUrl)
        .then(response => response.json())
        .then(data => {
            // Pass the product data to your popup handler
            showQuickviewPopup(data);
        })
        .catch(error => console.error("Error fetching product data:", error));
}

