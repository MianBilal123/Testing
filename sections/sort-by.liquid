function quickview(svgElement) {
    // Get the product URL from the clicked SVG element's data attribute
    const productUrl = svgElement.getAttribute('data-url');

    // Fetch product data from the Shopify API
    fetch(`${productUrl}.json`)
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            const product = data.product;

            // Populate quick view popup with product details
            document.querySelector('#quickview-info h1').textContent = product.title;
            document.querySelector('.product-price-main .price').innerHTML = product.variants[0].price / 100;

            // Main image
            const featuredImgMain = document.getElementById('featured-img-main');
            featuredImgMain.innerHTML = `<img src="${product.images[0].src}" alt="${product.title}" />`;

            // Secondary images
            const secondaryImgs = document.getElementById('secondary-imgs');
            secondaryImgs.innerHTML = product.images.map((img, index) => `
                <img src="${img.src}" alt="${product.title} - Image ${index + 1}" onclick="updateMainImage('${img.src}')" />
            `).join('');

            // Show popup
            document.getElementById('quickview-popup-wrapper').style.display = 'block';
        })
        .catch(error => {
            console.error('There was a problem with the fetch operation:', error);
        });
}

// Function to update the main image when a thumbnail is clicked
function updateMainImage(src) {
    document.querySelector('#featured-img-main img').src = src;
}




document.getElementById('add-to-cart').addEventListener('click', function () {
    const selectedVariantId = document.getElementById('SingleOptionSelector-0').value;
    const quantity = document.getElementById('quantity').value;

    addToCart(selectedVariantId, quantity);
});

function addToCart(variantId, quantity = 1) {
    fetch('/cart/add.js', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            id: variantId,
            quantity: quantity
        })
    })
    .then(response => response.json())
    .then(data => {
        console.log('Product added to cart:', data);
        window.location.href = '/cart';
    })
    .catch(error => {
        console.error('Error adding product to cart:', error);
        alert('Failed to add product to cart.');
    });
}
  
  
</script>

